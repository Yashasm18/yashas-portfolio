# ─────────────────────────────────────────────────────────
# Portfolio Environment Variables
# Copy this file to .env and fill in your own keys
# ─────────────────────────────────────────────────────────

# Gemini API Key (free at https://aistudio.google.com/)
# Used by the /play chess AI chat feature
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token (for live contribution graph)
# Create at: https://github.com/settings/tokens → "Fine-grained tokens"
# Required scope: read:user (public_repo if you want private contribs)
GITHUB_TOKEN=your_github_pat_here

# Your GitHub username (defaults to Yashasm18 if not set)
GITHUB_USERNAME=your_github_username
